{
  "name": "hueforge-web",
  "private": true,
  "version": "0.7.8",
  "type": "module",
  "description": "Turn any image into a multi-layer 3D-printable filament painting (STL/3MF)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "serve": "node server.mjs",
    "pack-deploy": "node scripts/pack-deploy.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/three": "^0.185.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
