{
  "name": "hueforge-web",
  "private": true,
  "version": "0.8.7",
  "type": "module",
  "description": "Превращает изображение в многослойную филаментную картину для 3D-печати (STL/3MF)",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "serve": "node server.mjs",
    "pack-deploy": "node scripts/pack-deploy.mjs",
    "changelog:sync": "node scripts/sync-changelog.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "electron:dev": "electron .",
    "electron:start": "npm run build && electron .",
    "dist": "npm run build && node scripts/electron-builder-resilient.mjs --win --x64",
    "dist:dir": "npm run build && node scripts/electron-builder-resilient.mjs --win --x64 --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/three": "^0.185.4",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.sovero.hueforge",
    "productName": "HueForge Desktop",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "electron-preload.cjs",
      "package.json"
    ],
    "win": {
      "executableName": "hueforge-desktop",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HueForge Desktop",
      "artifactName": "hueforge-desktop-setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Sovero",
        "repo": "hf",
        "private": true
      }
    ]
  }
}
